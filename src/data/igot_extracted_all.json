  "do_1143052789530787841562": {
    "id": "do_1143052789530787841562",
    "name": "Fire Safety in Healthcare Facilities",
    "description": "Healthcare facilities present unique and complex challenges for fire safety due to the presence of vulnerable patients, high-value equipment, and combustible materials. This course is designed to equip healthcare professionals, administrators, and support staff with the critical knowledge and skills to manage these risks effectively. The curriculum delves into the fundamental causes of hospital fires, different fire classifications, and the proper use of fire suppression equipment like extinguishers and alarm systems. A significant focus is placed on proactive and reactive strategies, including the development and implementation of robust fire safety and evacuation plans, with special attention to patient prioritization and movement challenges. The course also covers the importance of regulatory compliance with codes like the National Building Code (NBC) 2016 and the necessity of conducting regular mock drills to test and refine emergency procedures. Upon completion, participants will be prepared to lead fire safety initiatives, mitigate risks, and foster a resilient safety culture within their facilities.",
    "creator": "Sandeep Dhanda",
    "source": "Ministry of Health and Family Welfare",
    "organisation": [
      "Ministry of Health and Family Welfare"
    ],
    "duration": "4964",
