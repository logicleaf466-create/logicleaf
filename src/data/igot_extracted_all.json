    "subItems": [
      {
        "id": "do_1141533862295633921623",
        "name": "स्वच्छता ही सेवा - 2024 पर प्रशिक्षण मॉड्यूल",
        "mimeType": "application/vnd.ekstep.html-archive",
        "contentType": "Resource",
        "duration": "900",
        "artifactUrl": "https://storage.googleapis.com/igotprod/content/do_1141533862295633921623/artifact/do_1141533862295633921623_1727708440240_shs2024_hindi1727708429264.zip",
        "streamingUrl": "https://storage.googleapis.com/igotprod/content/html/do_1141533862295633921623-latest",
        "description": "आवासन एवं शहरी कार्य मंत्रालय (MoHUA) ने स्वच्छता ही सेवा (SHS) 2024 पर जागरूकता प्रशिक्षण पाठ्यक्रम शुरू किया है। यह पाठ्यक्रम सभी मंत्रालयों, राज्यों/केंद्र शासित प्रदेशों, शहरी स्थानीय निकायों के अधिकारियों, क्षेत्रीय इकाइयों और नागरिकों के लिए तैयार किया गया है, ताकि सभी स्वच्छ भारत मिशन के कचरा मुक्त भारत के लक्ष्य में सक्रिय रूप से शामिल हो सकें। इस पाठ्यक्रम का उद्देश्य लोगों को अपने दैनिक जीवन में स्वच्छता को शामिल करने के लिए प्रेरित करना और उन्हें सक्षम बनाना है, जिससे स्वच्छता, स्वास्थ्य और अपशिष्ट प्रबंधन के लिए ‘संपूर्ण समाज के दृष्टिकोण’ को मजबूती मिल सके।"
      },
      {
        "id": "do_114153388896780288112",
        "name": "स्वच्छता ही सेवा - 2024 पर प्रशिक्षण मॉड्यूल",
        "mimeType": "application/vnd.sunbird.questionset",
        "contentType": "SelfAssess",
        "description": "<p>सभी&nbsp;प्रश्न&nbsp;अनिवार्य&nbsp;हैं।&nbsp;मूल्यांकन&nbsp;में&nbsp;10&nbsp;प्रश्न&nbsp;हैं,&nbsp;मॉड्यूल&nbsp;पूरा&nbsp;करने&nbsp;के&nbsp;लिए&nbsp;आपको&nbsp;7&nbsp;प्रश्न&nbsp;पास&nbsp;करने&nbsp;होंगे।</p>\n"
      }
    ]
